BASE_URL=https://opensource-demo.orangehrmlive.com
BROWSER=chromium
HEADLESS=true
SLOW_MO=0
DEFAULT_TIMEOUT=30000

# Admin credentials for the shared "login once" storage state
ADMIN_USERNAME=Admin
ADMIN_PASSWORD=admin123

# Default password used when tests create new users
DEFAULT_USER_PASSWORD=Pass@1234

# AI provider: github, openai, grok, or anthropic
AI_PROVIDER=github
AI_MODEL=openai/gpt-4.1-mini
# GitHub Models / Copilot-backed access
GITHUB_TOKEN=
# OpenAI-compatible providers
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# xAI Grok
XAI_API_KEY=
# Anthropic Claude
ANTHROPIC_API_KEY=
# Set true to request an AI failure summary after failed Cucumber scenarios
AI_ANALYZE_FAILURES=false
