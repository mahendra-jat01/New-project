{
  "name": "playwright-cucumber-allure-framework",
  "version": "1.0.0",
  "description": "Automation testing framework using Playwright, Cucumber BDD, Page Object Model, and Allure reporting.",
  "main": "index.js",
  "scripts": {
    "test": "cucumber-js",
    "test:ci": "cucumber-js --format allure-cucumberjs/reporter --format-options \"{\\\"resultsDir\\\":\\\"allure-results\\\"}\"",
    "test:headed": "cross-env HEADLESS=false cucumber-js",
    "test:chrome": "cross-env BROWSER=chromium cucumber-js",
    "test:chrome:headed": "cross-env BROWSER=chromium HEADLESS=false cucumber-js",
    "test:firefox": "cross-env BROWSER=firefox cucumber-js",
    "test:webkit": "cross-env BROWSER=webkit cucumber-js",
    "test:tags": "cucumber-js --tags",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "report": "npm run allure:generate && npm run allure:open",
    "clean": "rimraf allure-results allure-report reports"
  },
  "keywords": [
    "playwright",
    "cucumber",
    "bdd",
    "allure",
    "pom",
    "javascript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cucumber/cucumber": "^11.2.0",
    "@playwright/test": "^1.52.0",
    "allure-commandline": "^2.34.1",
    "allure-cucumberjs": "^3.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "rimraf": "^6.0.1"
  }
}
